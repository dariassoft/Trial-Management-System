# Copy this file to Dokploy's Environment section.
# Rotate these credentials if this repository is public or already shared.

# -----------------------------------------------------------------------------
# Values required from Dokploy
# -----------------------------------------------------------------------------

# MySQL credentials used by both the backend and the mysql service.
DB_TYPE=mysql
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=nest_db
MYSQL_ROOT_PASSWORD=mypassword
MYSQL_DATABASE=nest_db
MYSQL_USER=myuser
MYSQL_PASSWORD=mypassword

# Backend authentication and CORS.
JWT_SECRET=cadena-aleatoria-segura
# The backend parses this value as a number of seconds.
JWT_EXPIRATION_TIME=2592000
FRONTEND_URLS=https://agronomic-tms.dariassoft.com.ar

# Public API URL embedded in the Nuxt build and used by the frontend at runtime.
NUXT_PUBLIC_API_BASE=https://api.agronomic-tms.dariassoft.com.ar/api/v1

# -----------------------------------------------------------------------------
# Runtime values used by the production containers
# -----------------------------------------------------------------------------
# These are already set by docker-compose.prod.yml or Dockerfile.prod. They are
# listed here so this file documents every production environment variable.
# Dokploy does not need to override them.
DB_HOST=mysql
DB_PORT=3306
NODE_ENV=production
DOCKERIZED=true
HOST=0.0.0.0
PORT=3000
NITRO_PORT=3000
