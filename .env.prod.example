# Copy these names to Dokploy's Environment section.
# Do not commit the real production values to the repository.

# MySQL credentials used by both the app and the mysql service.
DB_USER=change_me
DB_PASSWORD=change_me
DB_NAME=nest_db
MYSQL_ROOT_PASSWORD=change_me

# Backend authentication and CORS.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRATION_TIME=1d
FRONTEND_URLS=https://agronomic-tms.dariassoft.com.ar

# Used at frontend build time and runtime by Nuxt.
NUXT_PUBLIC_API_BASE=https://api.agronomic-tms.dariassoft.com.ar/api/v1