{
  "name": "tms-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "openapi:gen": "node scripts/generate-openapi.js",
    "postman:gen": "node scripts/openapi-to-postman.js",
    "docs:gen": "npm run openapi:gen && npm run postman:gen",
    "db:seed:auth": "mysql -h 127.0.0.1 -P 3306 -umyuser -pmypassword nest_db < docs/auth_seed.sql",
    "db:seed:auth:env": "sh -lc 'mysql -h ${DB_HOST:-127.0.0.1} -P ${DB_PORT:-3306} -u${DB_USER:-myuser} -p${DB_PASSWORD:-mypassword} ${DB_NAME:-nest_db} < docs/auth_seed.sql'",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --dataSource src/database/data-source.ts",
    "migration:gen": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/platform-express": "^11.1.8",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.7",
    "@types/multer": "^1.4.13",
    "@types/passport-jwt": "^4.0.1",
    "@types/serve-static": "^1.15.10",
    "openapi-to-postmanv2": "^4.24.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.15.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27"
  }
}
